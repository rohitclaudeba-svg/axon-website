# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=axon_website

# Admin auth (used once the admin panel/login is built)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Comma-separated list of origins allowed to call this API (e.g. the frontend's URL, admin panel's URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Enquiry email notifications via Gmail SMTP (optional — leave blank to disable).
# SMTP_PASS must be a Gmail App Password (Google Account → Security → 2-Step
# Verification → App passwords), not the normal Gmail login password.
SMTP_USER=
SMTP_PASS=
# SMTP_USER always receives alerts; list extra inboxes here, comma-separated.
ENQUIRY_NOTIFY_TO=
